{
  "name": "imaginarium-theater-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:official": "vite --host localhost --port 5173 --strictPort",
    "dev:unofficial": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "update:theater-lineups": "node scripts/update-theater-lineups.mjs",
    "archive:act-details": "node scripts/archive-act-details.mjs",
    "test": "node --test src/*.test.mjs scripts/*.test.mjs",
    "test:browser": "node scripts/browser-checks.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.64.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
